# =============================================================
# AAYUSH HEALTH CARE — SERVER ENVIRONMENT VARIABLES
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================

# ----- SERVER ------------------------------------------------
NODE_ENV=development
PORT=5000

# ----- MONGODB -----------------------------------------------
# MongoDB Atlas: https://cloud.mongodb.com → Connect → Drivers → Node.js
MONGO_URI=mongodb://localhost:27017/aayush_health_care

# ----- JWT ---------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING_ACCESS
JWT_REFRESH_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING_REFRESH
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ----- GOOGLE OAUTH ------------------------------------------
# Create credentials at: https://console.cloud.google.com
# Authorized redirect URI: http://localhost:5000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=REPLACE_WITH_YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# ----- FRONTEND ----------------------------------------------
# Used for Google OAuth redirect + email CTA buttons
FRONTEND_URL=http://localhost:5173

# ----- EMAIL (Nodemailer SMTP) --------------------------------
# For Gmail: use App Password (not account password)
#   Enable 2FA → https://myaccount.google.com/apppasswords
# For custom domain: use your SMTP provider's settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=REPLACE_WITH_GMAIL_OR_SMTP_USER
EMAIL_PASS=REPLACE_WITH_16_CHAR_APP_PASSWORD
EMAIL_FROM=noreply@aayushhealthcare.in

# ----- FAST2SMS (OTP + Notifications) -------------------------
# Sign up: https://www.fast2sms.com → Dev API → API Key
FAST2SMS_API_KEY=REPLACE_WITH_YOUR_FAST2SMS_API_KEY

# ----- CLINIC / ADMIN DETAILS --------------------------------
# Admin notification destination (email + SMS)
ADMIN_EMAIL=REPLACE_WITH_ADMIN_EMAIL
ADMIN_PHONE=9822843015
CLINIC_PHONE=+91 98228 43015
CLINIC_ADDRESS=Clinic Address, Pune, Maharashtra 411001

# ----- ADMIN SEED CREDENTIALS --------------------------------
# Used ONLY by: npm run seed:admin
# Do NOT use a weak password. Min 8 chars, use symbols.
ADMIN_SEED_EMAIL=admin@aayushhealth.in
ADMIN_SEED_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# ----- FILE UPLOADS ------------------------------------------
# Relative to server root — created automatically on startup
UPLOAD_DIR=uploads

# ----- RATE LIMITING -----------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ----- OTP ---------------------------------------------------
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6

# =============================================================
# PRODUCTION (Railway / Render) — set these in the platform panel
# =============================================================
# NODE_ENV=production
# MONGO_URI=<Atlas production connection string>
# FRONTEND_URL=https://your-vercel-app.vercel.app
# GOOGLE_CALLBACK_URL=https://your-railway-app.railway.app/api/v1/auth/google/callback
# EMAIL_SECURE=true
# EMAIL_PORT=465

